rules_version = '2';

// Regras do Firestore para o Grimório RPG.
// Cole este conteúdo em: Console do Firebase › Firestore Database › Regras › Publicar.
//
// Modelo de acesso: quem tem o link da mesa (código de 20 caracteres aleatórios) vê e edita as fichas.
// Não é possível listar as mesas existentes; sem o código, não há como chegar às fichas.
service cloud.firestore {
  match /databases/{database}/documents {

    match /mesas/{mesaId} {
      function mesaExiste() {
        return exists(/databases/$(database)/documents/mesas/$(mesaId));
      }

      function fichaValida() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'versao', 'criadoEm', 'atualizadoEm',
            'jogador', 'nome', 'raca', 'classe', 'nivel', 'dinheiro', 'idade', 'genero',
            'magiasHabilidades', 'personalidade', 'tracosPositivos', 'tracosNegativos',
            'equipamentos', 'atributos', 'magiasIds'
          ])
          && d.atributos is map
          && d.atributos.keys().hasOnly([
            'vida', 'ataque', 'defesa', 'agilidade', 'furtividade', 'inteligencia',
            'misticismo', 'precisao', 'percepcao', 'carisma', 'enganacao', 'sorte'
          ])
          && d.magiasIds is list
          && d.magiasIds.size() <= 400;
      }

      allow get: if true;
      allow create: if mesaId.matches('^[a-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['nome', 'criadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 80;

      match /fichas/{fichaId} {
        allow read: if true;
        allow create, update: if mesaExiste() && fichaValida();
        allow delete: if mesaExiste();
      }
    }
  }
}
